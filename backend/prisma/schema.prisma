// Data model from S4 (Phase 2 — Design), matching the diagrams approved at
// the defense: docs/media/image1.png (conceptual ER), docs/media/image7.png
// (domain classes) and docs/media/image8.png (tournament/round states and
// match lifecycle). See also docs/diagrama-componentes.md.
//
// Naming standard: every model, field and enum is named in English,
// regardless of the Spanish vocabulary used in the project documentation
// (Torneo, Jugador, Ronda, ...) — the documentation's domain terms map onto
// these English identifiers one-to-one, listed in each model's comment
// where the mapping isn't obvious from the name alone.
//
// Deliberate scope: only the entities from Specific Objective 3 (User,
// Role, Player, Tournament, Round, Match, Result, TiebreakCriterion,
// Standing, Enrollment). Club, Federation, CoachPlayer link, AuditLog and
// manual pairing adjustment belong to later increments (S10-S13 of the
// roadmap) and get added to the schema when that week is coded, not before.
//
// Enrollment was pulled forward to S6 (instead of waiting for S10-S13 like
// the rest of this original comment suggested) because HU06/HU07 depend on
// it directly to enforce RN-01 (no duplicate enrollment per tournament).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The source diagrams type "estado" as a generic string; refined to an enum
// here for database-level integrity, with the same values.
enum UserStatus {
  ACTIVE
  INACTIVE
}

// See docs/media/image8.png. IN_PROGRESS groups the round cycle
// (RoundGenerated/RecordingResults/StandingsUpdated), modeled with finer
// detail in RoundStatus.
enum TournamentStatus {
  CREATED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  FINISHED
}

enum RoundStatus {
  GENERATED
  RECORDING_RESULTS
  STANDINGS_UPDATED
}

// Match lifecycle (docs/media/image8.png, "Ciclo de Partida" swimlane).
enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  CORRECTED
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users User[]

  @@map("roles")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  roleId       String     @map("role_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // HU21/RN-10: registration isn't completed without this explicit
  // acceptance, and the date/version are stored (CA HU21, P23).
  // dataPolicyVersion references DATA_POLICY_VERSION in config/dataPolicy.ts.
  dataPolicyAccepted   Boolean   @default(false) @map("data_policy_accepted")
  dataPolicyAcceptedAt DateTime? @map("data_policy_accepted_at")
  dataPolicyVersion    String?   @map("data_policy_version")

  role                  Role                   @relation(fields: [roleId], references: [id])
  player                Player?
  organizedTournaments  Tournament[]           @relation("TournamentOrganizer")
  passwordResetRequests PasswordResetRequest[]
  dataRequests          DataRequest[]
  coachLinks            CoachPlayer[]          @relation("CoachLinks")
  auditLogs             AuditLog[]

  @@map("users")
}

// Closed catalog (DANE) instead of free text: keeps the field from being
// used to write anything. Editable from HU20, never required at registration.
enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

// Closed catalog aligned with the Colombian RLCPD (Registro de Localización
// y Caracterización de Personas con Discapacidad).
enum Disability {
  NONE
  PHYSICAL_MOTOR
  VISUAL
  HEARING
  COGNITIVE
  PSYCHOSOCIAL
  MULTIPLE
  OTHER
}

model Player {
  id             String      @id @default(uuid())
  userId         String      @unique @map("user_id")
  universityCode String      @map("university_code")
  program        String
  semester       Int
  // The next three are optional on purpose: they aren't part of
  // registration (HU01), they get filled in later from "Edit profile"
  // (HU20). Age isn't stored: it's computed in the mapper from birthDate so
  // there's no value that goes stale over time.
  birthDate      DateTime?   @map("birth_date")
  gender         Gender?
  disability     Disability?
  // HU23: a player belongs to at most one club at a time. Optional because
  // club membership isn't part of registration (HU01).
  clubId         String?     @map("club_id")

  user           User          @relation(fields: [userId], references: [id])
  club           Club?         @relation(fields: [clubId], references: [id])
  standings      Standing[]
  matchesAsWhite Match[]       @relation("MatchWhite")
  matchesAsBlack Match[]       @relation("MatchBlack")
  enrollments    Enrollment[]
  coachLinks     CoachPlayer[]

  @@map("players")
}

// HU23: a club is just a named group a player can belong to — no
// standalone admin beyond create/rename and enrolling/removing players.
model Club {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  players Player[]

  @@map("clubs")
}

// HU24: a coach follows a player's progress by linking to them directly (no
// tournament/club scoping — that's out of the documented scope for this HU).
// Either side can unlink; re-linking after that is just a new row.
model CoachPlayer {
  id        String   @id @default(uuid())
  coachId   String   @map("coach_id")
  playerId  String   @map("player_id")
  createdAt DateTime @default(now()) @map("created_at")

  coach  User   @relation("CoachLinks", fields: [coachId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([coachId, playerId])
  @@map("coach_players")
}

model Tournament {
  id                String           @id @default(uuid())
  name              String
  startDate         DateTime         @map("start_date")
  endDate           DateTime         @map("end_date")
  status            TournamentStatus @default(CREATED)
  format            String           @default("swiss")
  // HU05: not in the original class diagram (docs/media/image7.png only
  // defines id/name/dates/status/format); added because HU05's CA requires
  // persisting "rounds, time control and tiebreaks", and TiebreakCriterion
  // already covers tiebreaks but there was nowhere to store the rest.
  roundsCount       Int?             @map("rounds_count")
  timeControl       String?          @map("time_control")
  // Registration eligibility, validated in HU07 (RN-01 already covers
  // duplicates; this covers the program/semester criterion). null = no
  // restriction on that criterion. Deliberately NOT adding rating/Elo: the
  // project document excludes federated rating calculation from scope.
  restrictedProgram String?          @map("restricted_program")
  minimumSemester   Int?             @map("minimum_semester")
  organizerId       String           @map("organizer_id")
  createdAt         DateTime         @default(now()) @map("created_at")

  organizer        User                @relation("TournamentOrganizer", fields: [organizerId], references: [id])
  rounds           Round[]
  tiebreakCriteria TiebreakCriterion[]
  standings        Standing[]
  enrollments      Enrollment[]

  @@map("tournaments")
}

model Round {
  id           String      @id @default(uuid())
  tournamentId String      @map("tournament_id")
  number       Int
  status       RoundStatus @default(GENERATED)
  createdAt    DateTime    @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  matches    Match[]

  @@unique([tournamentId, number])
  @@map("rounds")
}

// Names aligned with the sustentation document's data dictionary
// ("Partida.id_blancas", "Partida.id_negras" -> whiteId/blackId) rather than
// the class diagram's "colorBlancas/colorNegras", for being more explicit.
// A bye is a match with blackId (or whiteId) null, with no "type" field of
// its own (docs/media/image7.png doesn't distinguish a match type).
model Match {
  id        String      @id @default(uuid())
  roundId   String      @map("round_id")
  board     Int
  whiteId   String?     @map("white_id")
  blackId   String?     @map("black_id")
  status    MatchStatus @default(SCHEDULED)
  createdAt DateTime    @default(now()) @map("created_at")

  round  Round   @relation(fields: [roundId], references: [id])
  white  Player? @relation("MatchWhite", fields: [whiteId], references: [id])
  black  Player? @relation("MatchBlack", fields: [blackId], references: [id])
  result Result?

  @@map("matches")
}

// Result recorded per match (the "registra" 1:1 relationship in
// docs/media/image1.png), not a shared catalog: every decided match has its
// own row with the date it was recorded. The catalog of allowed values
// (RN-03) is enforced with a CHECK, added by hand in the migration because
// Prisma doesn't express CHECK constraints declaratively.
model Result {
  id         String   @id @default(uuid())
  matchId    String   @unique @map("match_id")
  value      String
  recordedAt DateTime @default(now()) @map("recorded_at")

  match Match @relation(fields: [matchId], references: [id])

  @@map("results")
}

model TiebreakCriterion {
  id           String @id @default(uuid())
  tournamentId String @map("tournament_id")
  name         String
  order        Int

  tournament Tournament @relation(fields: [tournamentId], references: [id])

  @@unique([tournamentId, order])
  @@map("tiebreak_criteria")
}

model Standing {
  id              String  @id @default(uuid())
  tournamentId    String  @map("tournament_id")
  playerId        String  @map("player_id")
  score           Decimal @default(0) @db.Decimal(5, 2)
  buchholz        Decimal @default(0) @db.Decimal(6, 2)
  buchholzCut1    Decimal @default(0) @map("buchholz_cut1") @db.Decimal(6, 2)
  sonnebornBerger Decimal @default(0) @map("sonneborn_berger") @db.Decimal(6, 2)
  aro             Decimal @default(0) @db.Decimal(6, 2)

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  player     Player     @relation(fields: [playerId], references: [id])

  @@unique([tournamentId, playerId])
  @@map("standings")
}

// HU06/HU07: the official roster of a tournament's participants. Not in
// docs/media/image7.png (the diagram models "participa" as Player's access
// to Standing), but it's needed before a Standing exists: it's where RN-01
// is enforced (a player can't enroll twice in the same tournament).
model Enrollment {
  id           String    @id @default(uuid())
  tournamentId String    @map("tournament_id")
  playerId     String    @map("player_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  // HU27: a withdrawn player keeps their enrollment row (history, past
  // matches) but is excluded from the active roster and from future
  // pairings. null = still an active participant.
  withdrawnAt  DateTime? @map("withdrawn_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  player     Player     @relation(fields: [playerId], references: [id])

  @@unique([tournamentId, playerId])
  @@map("enrollments")
}

// HU19/RF11: the raw token is never persisted, only its hash — a database
// dump alone isn't enough to reset an account. No email infrastructure
// exists in this project's documented architecture yet, so the send is
// simulated (see services/passwordReset.service.ts); the model is already
// ready to plug in a real provider with no schema changes.
model PasswordResetRequest {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_requests")
}

// HU22/Colombian Law 1581 of 2012, art. 8: ARCO rights (Access,
// Rectification, Cancellation/Suppression) exercised by the data subject
// over their own data.
enum DataRequestType {
  ACCESS
  RECTIFICATION
  SUPPRESSION
}

// BLOCKED: suppression was requested but there's data indispensable to a
// tournament in progress (CA HU22), so the account is blocked instead of deleted.
enum DataRequestStatus {
  RESOLVED
  BLOCKED
}

// HU31/RN-11: trazabilidad de acciones administrativas críticas (cambio de
// rol, corrección de resultado, ajuste manual de emparejamiento, retiro de
// jugador). `action` is a short machine-readable code (e.g.
// "ROLE_CHANGED", "PLAYER_WITHDRAWN"), not a closed enum: the set of
// critical actions grows as later HUs (result correction, pairing
// adjustment) land, and a new one shouldn't require a migration.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model DataRequest {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  type      DataRequestType
  status    DataRequestStatus
  detail    String?
  createdAt DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("data_requests")
}
