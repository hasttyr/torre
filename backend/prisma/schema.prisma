// Modelo de datos de S4 (Fase 2 — Diseño), fiel a los diagramas ya
// aprobados en la sustentación: docs/media/image1.png (ER conceptual),
// docs/media/image7.png (clases de dominio) y docs/media/image8.png
// (estados de torneo/ronda y ciclo de partida). Ver también
// docs/diagrama-componentes.md.
//
// Alcance deliberado: solo las entidades de Objetivo específico 3
// (Usuario, Rol, Jugador, Torneo, Ronda, Partida, Resultado,
// CriterioDesempate, Clasificacion, Inscripcion). Club, Federación,
// EntrenadorJugador, Bitácora y el ajuste manual de emparejamientos
// pertenecen a incrementos posteriores (S10-S13 del roadmap) y se agregan
// al esquema cuando se codifique esa semana, no antes.
//
// Inscripcion se adelantó a S6 (en vez de esperar a S10-S13 como el resto
// de este comentario original sugería) porque HU06/HU07 dependen
// directamente de ella para aplicar RN-01 (no duplicados por torneo).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Los diagramas de origen tipan "estado" como string genérico; se refina a
// enum aquí por integridad a nivel de base de datos, con los mismos valores.
enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

// Ver docs/media/image8.png. EN_CURSO agrupa el ciclo de rondas
// (RondaGenerada/ResultadosEnRegistro/ClasificacionActualizada), que se
// modela con el detalle fino en EstadoRonda.
enum EstadoTorneo {
  CREADO
  INSCRIPCIONES_ABIERTAS
  INSCRIPCIONES_CERRADAS
  EN_CURSO
  FINALIZADO
}

enum EstadoRonda {
  GENERADA
  RESULTADOS_EN_REGISTRO
  CLASIFICACION_ACTUALIZADA
}

// Ciclo de partida (docs/media/image8.png, swimlane "Ciclo de Partida").
enum EstadoPartida {
  PROGRAMADA
  EN_JUEGO
  FINALIZADA
  CORREGIDA
}

model Rol {
  id     String @id @default(uuid())
  nombre String @unique

  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id           String        @id @default(uuid())
  nombre       String
  email        String        @unique
  passwordHash String        @map("password_hash")
  estado       EstadoUsuario @default(ACTIVO)
  rolId        String        @map("rol_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // HU21/RN-10: no se completa el registro sin esta aceptación explícita, y
  // fecha/versión quedan almacenadas (CA HU21, P23). consentimientoVersion
  // referencia DATA_POLICY_VERSION en config/dataPolicy.ts.
  consentimientoAceptado Boolean   @default(false) @map("consentimiento_aceptado")
  consentimientoFecha    DateTime? @map("consentimiento_fecha")
  consentimientoVersion  String?   @map("consentimiento_version")

  rol                      Rol                        @relation(fields: [rolId], references: [id])
  jugador                  Jugador?
  torneosOrganizados       Torneo[]                   @relation("TorneoOrganizador")
  solicitudesRecuperacion  SolicitudRecuperacion[]
  solicitudesDatos         SolicitudDatosPersonales[]

  @@map("usuarios")
}

// HU19/RF11: el token en texto plano nunca se persiste, solo su hash — un
// volcado de la base no alcanza para restablecer una cuenta. Sin
// infraestructura de correo en la arquitectura documentada, el envío se
// simula (ver services/passwordReset.service.ts); el modelo ya queda listo
// para conectar un proveedor real sin cambios de esquema.
model SolicitudRecuperacion {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  tokenHash String    @unique @map("token_hash")
  expiraEn  DateTime  @map("expira_en")
  usadoEn   DateTime? @map("usado_en")
  createdAt DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("solicitudes_recuperacion")
}

// HU22/Ley 1581 de 2012, art. 8: derechos ARCO (Acceso, Rectificación,
// Cancelación/Supresión) ejercidos por el titular sobre sus propios datos.
enum TipoSolicitudDatos {
  ACCESO
  RECTIFICACION
  SUPRESION
}

// BLOQUEADA: la supresión se pidió pero hay datos indispensables para un
// torneo en curso (CA HU22), así que se bloquea la cuenta en vez de borrarla.
enum EstadoSolicitudDatos {
  RESUELTA
  BLOQUEADA
}

model SolicitudDatosPersonales {
  id        String               @id @default(uuid())
  usuarioId String               @map("usuario_id")
  tipo      TipoSolicitudDatos
  estado    EstadoSolicitudDatos
  detalle   String?
  createdAt DateTime             @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("solicitudes_datos_personales")
}

// Catálogo cerrado (DANE) en vez de texto libre: evita que el campo se
// use para escribir cualquier cosa. Editable desde HU20, nunca obligatorio
// en el registro.
enum GeneroJugador {
  MASCULINO
  FEMENINO
  NO_BINARIO
  PREFIERE_NO_DECIR
}

// Catálogo cerrado alineado al Registro de Localización y Caracterización
// de Personas con Discapacidad (RLCPD) colombiano.
enum DiscapacidadJugador {
  NINGUNA
  FISICA_MOTRIZ
  VISUAL
  AUDITIVA
  COGNITIVA
  PSICOSOCIAL
  MULTIPLE
  OTRA
}

model Jugador {
  id                  String @id @default(uuid())
  usuarioId           String @unique @map("usuario_id")
  codigoUniversitario String @map("codigo_universitario")
  programa            String
  semestre            Int
  // Los tres siguientes son opcionales a propósito: no forman parte del
  // registro (HU01), se completan después desde "Editar perfil" (HU20).
  // La edad no se guarda: se calcula en el mapper a partir de
  // fechaNacimiento para no tener un valor que se desactualiza con el
  // tiempo.
  fechaNacimiento DateTime?            @map("fecha_nacimiento")
  genero          GeneroJugador?
  discapacidad    DiscapacidadJugador?

  usuario         Usuario         @relation(fields: [usuarioId], references: [id])
  clasificaciones Clasificacion[]
  partidasBlancas Partida[]       @relation("PartidaBlancas")
  partidasNegras  Partida[]       @relation("PartidaNegras")
  inscripciones   Inscripcion[]

  @@map("jugadores")
}

model Torneo {
  id            String       @id @default(uuid())
  nombre        String
  fechaInicio   DateTime     @map("fecha_inicio")
  fechaFin      DateTime     @map("fecha_fin")
  estado        EstadoTorneo @default(CREADO)
  formato       String       @default("suizo")
  // HU05: no están en el diagrama de clases original (docs/media/image7.png
  // solo define id/nombre/fechas/estado/formato); se agregan porque el CA de
  // HU05 exige persistir "rondas, ritmo y desempates" y CriterioDesempate ya
  // cubre desempates pero no había dónde guardar el resto.
  numeroRondas  Int?         @map("numero_rondas")
  ritmo         String?
  // Elegibilidad de inscripción, validada en HU07 (RN-01 ya cubre
  // duplicados; esto cubre el criterio de programa/semestre). null = sin
  // restricción en ese criterio. Deliberadamente NO se agrega rating/Elo:
  // el documento del proyecto excluye el cálculo de rating federativo del
  // alcance funcional.
  programaRestringido String? @map("programa_restringido")
  semestreMinimo      Int?    @map("semestre_minimo")
  organizadorId String       @map("organizador_id")
  createdAt     DateTime     @default(now()) @map("created_at")

  organizador        Usuario             @relation("TorneoOrganizador", fields: [organizadorId], references: [id])
  rondas             Ronda[]
  criteriosDesempate CriterioDesempate[]
  clasificaciones    Clasificacion[]
  inscripciones      Inscripcion[]

  @@map("torneos")
}

model Ronda {
  id        String      @id @default(uuid())
  torneoId  String      @map("torneo_id")
  numero    Int
  estado    EstadoRonda @default(GENERADA)
  createdAt DateTime    @default(now()) @map("created_at")

  torneo   Torneo    @relation(fields: [torneoId], references: [id])
  partidas Partida[]

  @@unique([torneoId, numero])
  @@map("rondas")
}

// Nombres alineados con el diccionario de datos del documento de
// sustentación ("Partida.id_blancas", "Partida.id_negras") en vez de
// "colorBlancas/colorNegras" del diagrama de clases, por ser más explícitos.
// Un bye es una partida con id_negras (o id_blancas) nulo, sin campo "tipo"
// propio (docs/media/image7.png no distingue tipo de partida).
model Partida {
  id        String        @id @default(uuid())
  rondaId   String        @map("ronda_id")
  mesa      Int
  idBlancas String?       @map("id_blancas")
  idNegras  String?       @map("id_negras")
  estado    EstadoPartida @default(PROGRAMADA)
  createdAt DateTime      @default(now()) @map("created_at")

  ronda     Ronda      @relation(fields: [rondaId], references: [id])
  blancas   Jugador?   @relation("PartidaBlancas", fields: [idBlancas], references: [id])
  negras    Jugador?   @relation("PartidaNegras", fields: [idNegras], references: [id])
  resultado Resultado?

  @@map("partidas")
}

// Registro de resultado por partida (relación 1:1 "registra" en
// docs/media/image1.png), no un catálogo compartido: cada partida decidida
// tiene su propia fila con la fecha en que se registró. El catálogo de
// valores permitidos (RN-03) se aplica con un CHECK, agregado a mano en la
// migración porque Prisma no expresa CHECK de forma declarativa.
model Resultado {
  id            String   @id @default(uuid())
  partidaId     String   @unique @map("partida_id")
  valor         String
  fechaRegistro DateTime @default(now()) @map("fecha_registro")

  partida Partida @relation(fields: [partidaId], references: [id])

  @@map("resultados")
}

model CriterioDesempate {
  id       String @id @default(uuid())
  torneoId String @map("torneo_id")
  nombre   String
  orden    Int

  torneo Torneo @relation(fields: [torneoId], references: [id])

  @@unique([torneoId, orden])
  @@map("criterios_desempate")
}

model Clasificacion {
  id              String  @id @default(uuid())
  torneoId        String  @map("torneo_id")
  jugadorId       String  @map("jugador_id")
  puntaje         Decimal @default(0) @db.Decimal(5, 2)
  buchholz        Decimal @default(0) @db.Decimal(6, 2)
  buchholzC1      Decimal @default(0) @map("buchholz_c1") @db.Decimal(6, 2)
  sonnebornBerger Decimal @default(0) @map("sonneborn_berger") @db.Decimal(6, 2)
  aro             Decimal @default(0) @db.Decimal(6, 2)

  torneo  Torneo  @relation(fields: [torneoId], references: [id])
  jugador Jugador @relation(fields: [jugadorId], references: [id])

  @@unique([torneoId, jugadorId])
  @@map("clasificacion")
}

// HU06/HU07: listado oficial de participantes de un torneo. No está en
// docs/media/image7.png (el diagrama modela "participa" como el acceso de
// Jugador a Clasificacion), pero se necesita antes de que exista
// clasificación: es el punto donde se aplica RN-01 (un jugador no puede
// inscribirse dos veces en el mismo torneo).
model Inscripcion {
  id        String   @id @default(uuid())
  torneoId  String   @map("torneo_id")
  jugadorId String   @map("jugador_id")
  createdAt DateTime @default(now()) @map("created_at")

  torneo  Torneo  @relation(fields: [torneoId], references: [id])
  jugador Jugador @relation(fields: [jugadorId], references: [id])

  @@unique([torneoId, jugadorId])
  @@map("inscripciones")
}
