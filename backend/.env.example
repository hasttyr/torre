PORT=4000
CORS_ORIGIN=http://localhost:5173

# Solo detrás de un proxy inverso: cuántos saltos confiar para leer la IP real del cliente.
# Con Vercel delante de Render, 2 (ver docs/despliegue.md).
# TRUST_PROXY=1

# Esquema "public" (el de PostgreSQL por defecto): con Prisma 7 el parámetro ?schema= de la URL ya no se usa.
DATABASE_URL="postgresql://usuario:password@localhost:5432/torre_central_hub"

# Obligatorio. En producción, al menos 32 caracteres aleatorios: openssl rand -hex 32
JWT_SECRET=changeme
JWT_EXPIRES_IN=1d

# NODE_ENV=production exige un JWT_SECRET fuerte y un proveedor de correo.
# NODE_ENV=development

# Dirección pública del frontend (base de los enlaces enviados por correo). Por defecto, CORS_ORIGIN.
# APP_URL=http://localhost:5173

# Proveedor de correo para los enlaces de recuperación de contraseña. Sin él, en
# desarrollo el enlace se escribe en la consola del servidor; en producción la
# recuperación queda desactivada (nunca se escribe el enlace en los logs).
# SMTP_URL=smtps://usuario:clave@smtp.proveedor.com:465
# MAIL_FROM="Torre Central Hub <no-reply@example.com>"

# Zona horaria de las fechas que escribe el servidor (p. ej. en los PDF exportados).
APP_TIMEZONE=America/Bogota
