{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run test:coverage)",
      "Bash(npm run test:integration)",
      "Bash(npm run test:e2e)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest run *)",
      "Bash(npm audit)",
      "Bash(npm audit --audit-level=high)",
      "Bash(npm audit --loglevel=http)",
      "Bash(npm ls *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)",
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run format:check)",
      "PowerShell(npm run build)",
      "PowerShell(npm test)",
      "PowerShell(npm run test:coverage)",
      "PowerShell(npm run test:integration)",
      "PowerShell(npm run test:e2e)",
      "PowerShell(npx tsc --noEmit)",
      "PowerShell(npx vitest run *)",
      "PowerShell(npm audit)",
      "PowerShell(npm audit --audit-level=high)",
      "PowerShell(npm audit --loglevel=http)",
      "PowerShell(npm ls *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch)",
      "PowerShell(git branch -a)",
      "PowerShell(git branch -vv)",
      "PowerShell(git branch --show-current)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(gh run list *)",
      "PowerShell(gh run view *)",
      "PowerShell(gh run watch *)"
    ]
  }
}
