{
  // The browser suite (e2e/): Node code driving Playwright, plus the scripts
  // it runs inside the page, which need the DOM's types.
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "lib": ["ES2023", "DOM"]
  },
  "include": ["playwright.config.ts", "e2e/**/*.ts"]
}
