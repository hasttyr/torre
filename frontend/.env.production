# Valores de producción que se compilan en la app (npm run build). Son públicos: quedan
# en el JavaScript que descarga cualquier visitante, así que nunca van secretos aquí.
# El socket en vivo va directo al backend en Render (Vercel no reescribe WebSockets);
# la misma dirección está en vercel.json, y deployment.test.ts comprueba que coincidan.
VITE_SOCKET_URL=https://torre-be.onrender.com
